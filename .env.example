# Firebase (Admin SDK / Cloud Functions)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
# Ative somente depois que todos os clientes tiverem um provedor App Check valido.
ENFORCE_APP_CHECK=false

# Web App (Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Chave publica do reCAPTCHA Enterprise cadastrada no Firebase App Check.
# Deixe vazia ate cadastrar o provedor; o cliente continuara funcionando sem bloqueio.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Mobile App (Expo)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# External APIs
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
EXPO_PUSH_ACCESS_TOKEN=
