rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /account_deletions/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Helper functions ───────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null
        && (!exists(/databases/$(database)/documents/account_deletions/$(request.auth.uid))
          || get(/databases/$(database)/documents/account_deletions/$(request.auth.uid)).data.status == 'pending');
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isInstrutor() {
      return isSignedIn() && request.auth.token.role == 'instrutor';
    }

    function isCliente() {
      return isSignedIn()
        && request.auth.token.role == 'cliente'
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Acesso por cliente: Estudos/Catálogo ────────────────────────
    function estudosDisponivelGlobalmente() {
      return exists(/databases/$(database)/documents/app_config/acessos)
        && get(/databases/$(database)/documents/app_config/acessos).data.estudos_disponivel == true;
    }

    function catalogoDisponivelGlobalmente() {
      return exists(/databases/$(database)/documents/app_config/acessos)
        && get(/databases/$(database)/documents/app_config/acessos).data.catalogo_disponivel == true;
    }

    // get()/exists() calls count against a per-request quota; resolve the doc once
    // and check the resolved map here instead of calling get() again per field.
    function moduloConcedidoValido(modulo) {
      return modulo.habilitado == true
        && (modulo.expira_em == null || modulo.expira_em > request.time);
    }

    // Conta suspensa (users/{uid}.is_active == false) não deve manter acesso a Estudos/
    // Catálogo só porque o token atual ainda não expirou (spec seção 5, item 1).
    // Acessar um campo ausente com .data.campo é erro de avaliação em rules (não null) —
    // por isso o 'in' antes de ler is_active; sem ele, doc sem o campo negaria tudo.
    function perfilAtivoData(profile) {
      return !('is_active' in profile) || profile.is_active != false;
    }

    function perfilAtivo() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && perfilAtivoData(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    // Mesmo cuidado para o conteúdo: doc sem is_active/ativo ainda não passou pelo backfill
    // (scripts/backfill-is-active.mjs) — tratar como ativo em vez de negar por erro de avaliação.
    function isActiveOuAusente(doc) {
      return !('is_active' in doc) || doc.is_active != false;
    }

    function isAtivoOuAusente(doc) {
      return !('ativo' in doc) || doc.ativo != false;
    }

    function canAccessEstudos() {
      return isCliente()
        && perfilAtivo()
        && estudosDisponivelGlobalmente()
        && exists(/databases/$(database)/documents/acessos_clientes/$(request.auth.uid))
        && moduloConcedidoValido(get(/databases/$(database)/documents/acessos_clientes/$(request.auth.uid)).data.estudos);
    }

    function canAccessCatalogo() {
      return isCliente()
        && perfilAtivo()
        && catalogoDisponivelGlobalmente()
        && exists(/databases/$(database)/documents/acessos_clientes/$(request.auth.uid))
        && moduloConcedidoValido(get(/databases/$(database)/documents/acessos_clientes/$(request.auth.uid)).data.catalogo);
    }

    function ownsCliente(clienteId) {
      return isCliente()
        && exists(/databases/$(database)/documents/clientes/$(clienteId))
        && get(/databases/$(database)/documents/clientes/$(clienteId)).data.profile_id == request.auth.uid;
    }

    function isAssignedToCliente(clienteId) {
      return isInstrutor()
        && exists(/databases/$(database)/documents/clientes/$(clienteId))
        && get(/databases/$(database)/documents/clientes/$(clienteId)).data.assigned_instrutor_id == request.auth.uid;
    }

    function ownsProcesso(processoId) {
      return isCliente()
        && exists(/databases/$(database)/documents/cliente_processos/$(processoId))
        && ownsCliente(get(/databases/$(database)/documents/cliente_processos/$(processoId)).data.cliente_id);
    }

    function isAssignedToProcesso(processoId) {
      return isInstrutor()
        && exists(/databases/$(database)/documents/cliente_processos/$(processoId))
        && isAssignedToCliente(get(/databases/$(database)/documents/cliente_processos/$(processoId)).data.cliente_id);
    }

    // O cliente não escolhe o texto do snapshot: nome/preço enviados precisam bater com o
    // servico/variacao reais, ou ele poderia registrar um preço mais baixo do que o real.
    function servicoSnapshotConfere(servicoId, variacaoId) {
      return request.resource.data.servico_snapshot.nome == get(/databases/$(database)/documents/servicos/$(servicoId)).data.nome
        && request.resource.data.servico_snapshot.preco_jpy == get(/databases/$(database)/documents/servicos/$(servicoId)).data.preco_jpy
        && (
          variacaoId == null
          || (
            request.resource.data.variacao_snapshot.nome == get(/databases/$(database)/documents/servico_variacoes/$(variacaoId)).data.nome
            && request.resource.data.variacao_snapshot.preco_jpy == get(/databases/$(database)/documents/servico_variacoes/$(variacaoId)).data.preco_jpy
          )
        );
    }

    function userSelfEditableFields() {
      return [
        'full_name',
        'phone',
        'whatsapp',
        'avatar_url',
        'preferred_lang',
        'endereco_jp',
        'mapa_link_jp',
        'updated_at'
      ];
    }

    function clienteSelfEditableFields() {
      return [
        'cpf',
        'data_nascimento',
        'endereco_jp',
        'cidade_jp',
        'cep_jp',
        'data_entrada_japao',
        'visto_tipo',
        'observacoes_cliente',
        'nome_japones',
        'nacionalidade',
        'zairyu_card',
        'visto_validade',
        'profissao_tipo',
        'profissao_empresa',
        'provincia_jp',
        'bairro_jp',
        'numero_bloco_jp',
        'apartamento_jp',
        'complemento_jp',
        'mapa_link_jp',
        'updated_at'
      ];
    }

    // ── /users/{uid} — profiles ────────────────────────────────────
    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userSelfEditableFields()));
      allow delete: if isAdmin();
    }

    // ── /clientes/{clienteId} ──────────────────────────────────────
    match /clientes/{clienteId} {
      allow read: if isAdmin()
        || (isInstrutor() && resource.data.assigned_instrutor_id == request.auth.uid)
        || (isCliente() && resource.data.profile_id == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (
          isCliente()
          && resource.data.profile_id == request.auth.uid
          && request.resource.data.profile_id == resource.data.profile_id
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(clienteSelfEditableFields())
        );
      allow delete: if isAdmin();

      // Subcollections: documentos, contatos, habilitacoes, entrada_saida, historico, materiais_progresso, simulado_resultado
      match /documentos/{docId} {
        allow read: if isAdmin()
          || (isInstrutor() && get(/databases/$(database)/documents/clientes/$(clienteId)).data.assigned_instrutor_id == request.auth.uid)
          || (isCliente() && get(/databases/$(database)/documents/clientes/$(clienteId)).data.profile_id == request.auth.uid);
        allow create: if isAdmin()
          || (ownsCliente(clienteId)
              && request.resource.data.cliente_id == clienteId
              && request.resource.data.status == 'enviado'
              && request.resource.data.revisado_por == null
              && request.resource.data.revisado_em == null
              && request.resource.data.arquivo_url is string
              && request.resource.data.arquivo_url.matches('^documentos/' + clienteId + '/[^/]+$')
              && request.resource.data.keys().hasOnly([
                'cliente_id', 'template_id', 'nome_custom', 'status', 'arquivo_url',
                'arquivo_nome', 'arquivo_tamanho', 'arquivo_tipo', 'data_validade',
                'observacao', 'revisado_por', 'revisado_em', 'created_at', 'updated_at'
              ]));
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /contatos/{id} {
        allow read, write: if isAdmin()
          || (isCliente() && get(/databases/$(database)/documents/clientes/$(clienteId)).data.profile_id == request.auth.uid);
      }

      match /habilitacoes/{id} {
        allow read, write: if isAdmin()
          || (isCliente() && get(/databases/$(database)/documents/clientes/$(clienteId)).data.profile_id == request.auth.uid);
      }

      match /entrada_saida/{id} {
        allow read, write: if isAdmin()
          || (isCliente() && get(/databases/$(database)/documents/clientes/$(clienteId)).data.profile_id == request.auth.uid);
      }

      match /historico/{id} {
        allow read: if isAdmin()
          || (isCliente() && get(/databases/$(database)/documents/clientes/$(clienteId)).data.profile_id == request.auth.uid);
        allow create: if isAdmin() || isAssignedToCliente(clienteId);
        allow update, delete: if isAdmin();
      }

      match /materiais_progresso/{materialId} {
        allow read, write: if isAdmin()
          || (canAccessEstudos() && get(/databases/$(database)/documents/clientes/$(clienteId)).data.profile_id == request.auth.uid);
      }

      match /simulado_resultado/{id} {
        allow read: if isAdmin()
          || (canAccessEstudos() && get(/databases/$(database)/documents/clientes/$(clienteId)).data.profile_id == request.auth.uid);
        allow create: if isAdmin()
          || (canAccessEstudos() && get(/databases/$(database)/documents/clientes/$(clienteId)).data.profile_id == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }

    // Collection group: documentos (for listPendingDocumentos)
    match /{path=**}/documentos/{docId} {
      allow read: if isAdmin()
        || (resource.data.cliente_id != null && isAssignedToCliente(resource.data.cliente_id));
    }

    // ── /agendamentos/{id} ─────────────────────────────────────────
    match /agendamentos/{id} {
      allow read: if isAdmin()
        || (isInstrutor() && resource.data.instrutor_id == request.auth.uid)
        || (isCliente() && resource.data.cliente_id != null
            && get(/databases/$(database)/documents/clientes/$(resource.data.cliente_id)).data.profile_id == request.auth.uid);
      allow create: if isAdmin()
        || (isInstrutor()
            && request.resource.data.instrutor_id == request.auth.uid
            && request.resource.data.cliente_id != null
            && isAssignedToCliente(request.resource.data.cliente_id));
      allow update: if isAdmin()
        || (isInstrutor()
            && resource.data.instrutor_id == request.auth.uid
            && request.resource.data.instrutor_id == request.auth.uid
            && request.resource.data.cliente_id == resource.data.cliente_id);
      allow delete: if isAdmin();
    }

    // ── /servicos/{id} ─────────────────────────────────────────────
    // Catálogo: leitura exige concessão individual + disponibilidade global.
    match /servicos/{id} {
      // is_active também na leitura por ID, não só na listagem: senão um cliente com
      // Catálogo liberado ainda lê um serviço desativado direto pelo id.
      allow read: if isAdmin() || isInstrutor() || (canAccessCatalogo() && isActiveOuAusente(resource.data));
      allow write: if isAdmin();

      match /etapa_templates/{tplId} {
        allow read: if isAdmin() || isInstrutor() || canAccessCatalogo();
        allow write: if isAdmin();
      }
    }

    // ── /servico_variacoes/{id} ───────────────────────────────────
    match /servico_variacoes/{id} {
      // Campo real de ativação aqui é `ativo`, não `is_active` (ver seção 9 da spec).
      allow read: if isAdmin() || isInstrutor() || (canAccessCatalogo() && isAtivoOuAusente(resource.data));
      allow write: if isAdmin();
    }

    // ── /pagamentos/{id} ──────────────────────────────────────────
    match /pagamentos/{id} {
      allow read: if isAdmin()
        || (isCliente() && resource.data.cliente_id != null
            && get(/databases/$(database)/documents/clientes/$(resource.data.cliente_id)).data.profile_id == request.auth.uid);
      allow create, update, delete: if isAdmin();

      match /parcelas/{parId} {
        allow read: if isAdmin()
          || (isCliente() && get(/databases/$(database)/documents/pagamentos/$(id)).data.cliente_id != null
              && get(/databases/$(database)/documents/clientes/$(get(/databases/$(database)/documents/pagamentos/$(id)).data.cliente_id)).data.profile_id == request.auth.uid);
        allow write: if isAdmin();
      }
    }

    // ── /contratos/{id} ───────────────────────────────────────────
    match /contratos/{id} {
      allow read: if isAdmin()
        || (isCliente() && resource.data.cliente_id != null
            && get(/databases/$(database)/documents/clientes/$(resource.data.cliente_id)).data.profile_id == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isCliente() && resource.data.cliente_id != null
            && get(/databases/$(database)/documents/clientes/$(resource.data.cliente_id)).data.profile_id == request.auth.uid
            && resource.data.status == 'enviado'
            && request.resource.data.status == 'assinado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'assinatura_url', 'ip_assinatura', 'assinado_em', 'updated_at'
            ]));
      allow delete: if isAdmin();
    }

    // ── /contrato_templates/{id} ───────────────────────────────────
    match /contrato_templates/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── /materiais/{id} ───────────────────────────────────────────
    // Estudos: leitura exige concessão individual + disponibilidade global.
    // is_public NÃO é mais uma exceção — toda a área Estudos exige a concessão.
    match /materiais/{id} {
      // is_active também na leitura por ID, não só na listagem: senão um cliente com
      // Estudos liberado ainda lê um material desativado direto pelo id.
      allow read: if isAdmin() || isInstrutor() || (canAccessEstudos() && isActiveOuAusente(resource.data));
      allow write: if isAdmin();

      match /cards/{cardId} {
        allow read: if isAdmin() || isInstrutor()
          || (canAccessEstudos() && get(/databases/$(database)/documents/materiais/$(id)).data.is_active == true);
        allow write: if isAdmin();
      }
    }

    // ── /app_config/{id} ──────────────────────────────────────────
    // Public app preferences used by client/mobile screens
    match /app_config/{id} {
      allow get: if id == 'public' || isAdmin()
        || (id == 'acessos' && (isCliente() || isInstrutor()));
      allow list: if isAdmin();
      // 'acessos' is written only by the setClientModuleAvailability callable (Admin SDK
      // bypasses rules); admins get no direct client-SDK write, so the audit trail can't be skipped.
      allow write: if id != 'acessos' && isAdmin();

      match /historico/{eventoId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // ── /acessos_clientes/{uid} ────────────────────────────────────
    // Per-client module grants (Estudos/Catálogo). Written only via callable (Admin SDK).
    match /acessos_clientes/{uid} {
      allow get: if isAdmin() || isOwner(uid);
      allow list: if isAdmin();
      allow write: if false;

      match /historico/{eventoId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // ── /categorias_material/{id} ─────────────────────────────────
    match /categorias_material/{id} {
      allow read: if isAdmin() || isInstrutor() || canAccessEstudos();
      allow write: if isAdmin();
    }

    // ── /simulado_config/{materialId} ─────────────────────────────
    match /simulado_config/{materialId} {
      allow read: if isAdmin() || isInstrutor() || canAccessEstudos();
      allow write: if isAdmin();

      match /questoes/{qId} {
        allow read: if isAdmin() || isInstrutor() || canAccessEstudos();
        allow write: if isAdmin();
      }
    }

    // ── /questoes/{id} ────────────────────────────────────────────
    match /questoes/{id} {
      allow read: if isAdmin() || isInstrutor() || canAccessEstudos();
      allow write: if isAdmin();

      match /opcoes/{opId} {
        allow read: if isAdmin() || isInstrutor() || canAccessEstudos();
        allow write: if isAdmin();
      }

      match /imagens/{imgId} {
        allow read: if isAdmin() || isInstrutor() || canAccessEstudos();
        allow write: if isAdmin();
      }

      match /explicacao_imagens/{imgId} {
        allow read: if isAdmin() || isInstrutor() || canAccessEstudos();
        allow write: if isAdmin();
      }

      match /erros/{errId} {
        allow read: if isAdmin();
        allow create: if isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    // ── /questao_erro_reports/{id} ────────────────────────────────
    match /questao_erro_reports/{id} {
      allow read: if isAdmin();
      allow create: if (isAdmin()
          || ((isInstrutor() || canAccessEstudos()) && request.resource.data.reportado_por == request.auth.uid))
        && request.resource.data.status == 'pendente'
        && request.resource.data.descricao is string
        && request.resource.data.descricao.size() >= 5
        && request.resource.data.descricao.size() <= 2000
        && request.resource.data.questao_id is string
        && exists(/databases/$(database)/documents/questoes/$(request.resource.data.questao_id))
        && request.resource.data.keys().hasOnly([
          'questao_id', 'reportado_por', 'descricao', 'status', 'created_at', 'updated_at'
        ]);
      allow update, delete: if isAdmin();
    }

    // ── /simulado_resultados/{id} ─────────────────────────────────
    match /simulado_resultados/{id} {
      allow read: if isAdmin()
        || (
          canAccessEstudos()
          && (
            resource.data.cliente_id == request.auth.uid
            || (
              resource.data.cliente_id != null
              && exists(/databases/$(database)/documents/clientes/$(resource.data.cliente_id))
              && get(/databases/$(database)/documents/clientes/$(resource.data.cliente_id)).data.profile_id == request.auth.uid
            )
          )
        );
      allow create: if isAdmin()
        || (
          canAccessEstudos()
          && (
            request.resource.data.cliente_id == request.auth.uid
            || (
              request.resource.data.cliente_id != null
              && exists(/databases/$(database)/documents/clientes/$(request.resource.data.cliente_id))
              && get(/databases/$(database)/documents/clientes/$(request.resource.data.cliente_id)).data.profile_id == request.auth.uid
            )
          )
        );
      allow update, delete: if isAdmin();
    }

    // ── /avaliacoes/{id} ──────────────────────────────────────────
    match /avaliacoes/{id} {
      allow read: if isAdmin()
        || (isInstrutor() && resource.data.instrutor_id == request.auth.uid)
        || (isCliente() && resource.data.cliente_id != null
            && get(/databases/$(database)/documents/clientes/$(resource.data.cliente_id)).data.profile_id == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── /notificacoes/{id} ────────────────────────────────────────
    match /notificacoes/{id} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.destinatario_id == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.destinatario_id == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida', 'lida_em']));
      allow delete: if isAdmin();
    }

    // ── /push_tokens/{id} ─────────────────────────────────────────
    match /push_tokens/{id} {
      allow read, delete: if isSignedIn()
        && resource.data.profile_id == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.profile_id == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'profile_id', 'token', 'platform', 'created_at', 'updated_at'
        ]);
      allow update: if isSignedIn()
        && resource.data.profile_id == request.auth.uid
        && request.resource.data.profile_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'token', 'platform', 'updated_at'
        ]);
    }

    // ── /rotas_dia/{id} ───────────────────────────────────────────
    match /rotas_dia/{id} {
      allow read: if isAdmin()
        || (isInstrutor() && resource.data.instrutor_id == request.auth.uid);
      allow create: if isAdmin()
        || (isInstrutor() && request.resource.data.instrutor_id == request.auth.uid);
      allow update: if isAdmin()
        || (isInstrutor() && resource.data.instrutor_id == request.auth.uid);
      allow delete: if isAdmin();

      match /paradas/{paradaId} {
        allow read: if isAdmin()
          || (isInstrutor() && get(/databases/$(database)/documents/rotas_dia/$(id)).data.instrutor_id == request.auth.uid);
        allow write: if isAdmin()
          || (isInstrutor() && get(/databases/$(database)/documents/rotas_dia/$(id)).data.instrutor_id == request.auth.uid);
      }
    }

    // ── /destinos_fixos/{id} ──────────────────────────────────────
    match /destinos_fixos/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── /documento_templates/{id} ─────────────────────────────────
    match /documento_templates/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── /cliente_processos/{id} ───────────────────────────────────
    match /cliente_processos/{id} {
      allow read: if isAdmin()
        || (isInstrutor() && get(/databases/$(database)/documents/clientes/$(resource.data.cliente_id)).data.assigned_instrutor_id == request.auth.uid)
        || (isCliente() && get(/databases/$(database)/documents/clientes/$(resource.data.cliente_id)).data.profile_id == request.auth.uid);
      allow create: if isAdmin()
        || (
          canAccessCatalogo()
          && request.resource.data.status == 'analise'
          && request.resource.data.valor_acordado_jpy == null
          && request.resource.data.cliente_id != null
          && get(/databases/$(database)/documents/clientes/$(request.resource.data.cliente_id)).data.profile_id == request.auth.uid
          && servicoSnapshotConfere(request.resource.data.servico_id, request.resource.data.variacao_id)
          && request.resource.data.keys().hasOnly([
            'cliente_id',
            'servico_id',
            'variacao_id',
            'data_inicio',
            'valor_acordado_jpy',
            'status',
            'notas',
            'servico_snapshot',
            'variacao_snapshot',
            'created_at',
            'updated_at'
          ])
        );
      allow update, delete: if isAdmin();
    }

    // ── /processo_etapas/{id} ─────────────────────────────────────
    match /processo_etapas/{id} {
      allow read: if isAdmin()
        || (resource.data.processo_id != null
            && (ownsProcesso(resource.data.processo_id)
                || isAssignedToProcesso(resource.data.processo_id)));
      allow write: if isAdmin();
    }

    // ── /etapa_templates/{id} ─────────────────────────────────────
    match /etapa_templates/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── /faq/{id} ─────────────────────────────────────────────────
    match /faq/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── /avisos/{id} ──────────────────────────────────────────────
    match /avisos/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
