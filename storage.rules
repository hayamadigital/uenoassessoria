rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null
        && (!firestore.exists(/databases/(default)/documents/account_deletions/$(request.auth.uid))
          || firestore.get(/databases/(default)/documents/account_deletions/$(request.auth.uid)).data.status == 'pending');
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isInstrutor() {
      return isSignedIn() && request.auth.token.role == 'instrutor';
    }

    function isVerifiedCliente() {
      return isSignedIn()
        && request.auth.token.role == 'cliente'
        && request.auth.token.email_verified == true;
    }

    function ownsCliente(clienteId) {
      return isVerifiedCliente()
        && firestore.get(/databases/(default)/documents/clientes/$(clienteId)).data.profile_id == request.auth.uid;
    }

    function isAssignedToCliente(clienteId) {
      return isInstrutor()
        && firestore.get(/databases/(default)/documents/clientes/$(clienteId)).data.assigned_instrutor_id == request.auth.uid;
    }

    function ownsPagamento(pagamentoId) {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/pagamentos/$(pagamentoId)).data.cliente_id != null
        && ownsCliente(firestore.get(/databases/(default)/documents/pagamentos/$(pagamentoId)).data.cliente_id);
    }

    function isAssignedToPagamento(pagamentoId) {
      return isInstrutor()
        && firestore.get(/databases/(default)/documents/pagamentos/$(pagamentoId)).data.cliente_id != null
        && isAssignedToCliente(firestore.get(/databases/(default)/documents/pagamentos/$(pagamentoId)).data.cliente_id);
    }

    // ── Acesso por cliente: Estudos ───────────────────────────────
    function estudosDisponivelGlobalmente() {
      return firestore.exists(/databases/(default)/documents/app_config/acessos)
        && firestore.get(/databases/(default)/documents/app_config/acessos).data.estudos_disponivel == true;
    }

    // firestore.get()/exists() calls count against a per-request quota; resolve the doc
    // once and check the resolved map here instead of calling get() again per field.
    function moduloConcedidoValido(modulo) {
      return modulo.habilitado == true
        && (modulo.expira_em == null || modulo.expira_em > request.time);
    }

    function canAccessEstudos() {
      return isVerifiedCliente()
        && estudosDisponivelGlobalmente()
        && firestore.exists(/databases/(default)/documents/acessos_clientes/$(request.auth.uid))
        && moduloConcedidoValido(firestore.get(/databases/(default)/documents/acessos_clientes/$(request.auth.uid)).data.estudos);
    }

    function isImage(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    function isDocument(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('(application/pdf|image/.*)');
    }

    // ── avatares/{uid}/ ─────────────────────────────────────────
    // Owner writes, everyone reads (public)
    match /avatares/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && isImage(5 * 1024 * 1024);
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // ── documentos/{clienteId}/ ────────────────────────────────
    // Admin: full; Cliente: read own + create; Instrutor: read assigned (server-enforced via rules approximation)
    match /documentos/{clienteId}/{fileName} {
      allow read: if isAdmin() || ownsCliente(clienteId) || isAssignedToCliente(clienteId);
      allow create: if (isAdmin() || ownsCliente(clienteId) || isAssignedToCliente(clienteId))
        && isDocument(20 * 1024 * 1024);
      allow update, delete: if isAdmin();
    }

    // ── contratos/{clienteId}/{contratoId}/ ───────────────────
    // Admin: full; Cliente: read only
    match /contratos/{clienteId}/{contratoId}/{fileName} {
      allow read: if isAdmin() || ownsCliente(clienteId) || isAssignedToCliente(clienteId);
      allow write: if isAdmin();
    }

    // ── comprovantes/{pagamentoId}/ ───────────────────────────
    // Admin: full; Cliente: read own; Instrutor: read
    match /comprovantes/{pagamentoId}/{fileName} {
      allow read: if isAdmin() || ownsPagamento(pagamentoId) || isAssignedToPagamento(pagamentoId);
      allow create: if (isAdmin() || ownsPagamento(pagamentoId))
        && isDocument(20 * 1024 * 1024);
      allow update, delete: if isAdmin();
    }

    // Legacy expense receipts without a payment id are restricted to admins.
    match /comprovantes/{fileName} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && isDocument(20 * 1024 * 1024);
    }

    // ── materiais/ ────────────────────────────────────────────
    // Estudos: leitura exige concessão individual + disponibilidade global.
    // public/ deixou de ser uma exceção — toda a área Estudos exige a concessão.
    match /materiais/{allPaths=**} {
      allow read: if isAdmin() || isInstrutor() || canAccessEstudos();
      allow write: if isAdmin();
    }

    match /materiais/public/{fileName} {
      allow read: if isAdmin() || isInstrutor() || canAccessEstudos();
      allow write: if isAdmin();
    }

    // ── assinaturas/{clienteId}/ ──────────────────────────────
    // Cliente uploads own signature; Admin: full
    match /assinaturas/{clienteId}/{fileName} {
      allow read: if isAdmin() || ownsCliente(clienteId);
      allow create: if ownsCliente(clienteId)
        && isImage(5 * 1024 * 1024);
      allow update, delete: if isAdmin();
    }

    // ── imagens/ — generic images ─────────────────────────────
    match /imagens/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── avisos/ ───────────────────────────────────────────────────
    match /avisos/{avisoId}/{allFiles=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
